[Unit]
Description=TelTest Lightweight Extraction Scheduler
After=network-online.target teltest.service
Wants=network-online.target

[Service]
Type=oneshot

User=www-data
Group=www-data

WorkingDirectory=/opt/teltest/repo

EnvironmentFile=/etc/teltest/teltest.env

Environment=PYTHONPATH=/opt/teltest/repo
Environment=PYTHONDONTWRITEBYTECODE=1

ExecStart=/usr/bin/flock -n -E 0 /var/lib/teltest/locks/scheduler.lock /opt/teltest/venv/bin/python /opt/teltest/repo/scheduler_worker.py

Nice=10

CPUWeight=25
IOWeight=25

MemoryHigh=220M
MemoryMax=320M

TimeoutStartSec=900

NoNewPrivileges=true
PrivateTmp=true

ProtectSystem=full

ReadWritePaths=/var/lib/teltest
ReadWritePaths=/opt/teltest/repo
